# =============================================================================
# huddlekit — environment variables
# =============================================================================
#
# HOW THIS FILE WORKS
#   1. Copy it:            cp .env.example .env
#   2. Fill in the values you need below.
#   3. Never commit `.env` — it is gitignored. Only `.env.example` is tracked.
#
# There is ONE env file for the whole monorepo, and it lives here at the root.
# Apps and packages read it through `keys.ts` files, which validate every
# variable with zod (via @alice/environment), so mistakes fail fast with a
# clear message. When you add a variable to a `keys.ts`, add it here too,
# with a comment saying what it is, where to get it, and whether it's required.
#
# Conventions:
#   - Empty values count as "not set" (emptyStringAsUndefined), so leaving
#     an optional variable blank is safe.
#   - [required] must be set for the app to start. [optional] can be left blank.
#   - Don't wrap values in quotes unless they contain spaces.
# =============================================================================


# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# [optional] Runtime mode: development | test | production
# Defaults to "development" when blank. Most hosts set this for you in
# production, so you rarely need it here.
NODE_ENV=development


# -----------------------------------------------------------------------------
# Backend — Hono API (apps/backend)
# -----------------------------------------------------------------------------

# [optional] Port the API listens on. Defaults to 9000 when blank.
# Named BACKEND_PORT (not PORT) so it can't clash with the Next.js apps,
# which read PORT from the same root env file.
BACKEND_PORT=9000

# [optional] Browser origins allowed to call the API (CORS), comma-separated.
# Must include every web app that signs users in (website 3000, platform 8000).
# Defaults to http://localhost:3000,http://localhost:8000 when blank.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# [optional] Backend log verbosity: fatal | error | warn | info | debug | trace | silent
# Defaults to "info" when blank.
LOG_LEVEL=info

# [optional] Longest an API request may take, in milliseconds, before it gets a
# 504. Defaults to 30000.
REQUEST_TIMEOUT_MS=30000

# [optional] Largest request body the API accepts, in bytes. Defaults to 1048576 (1 MiB).
# File uploads go straight to S3, so API bodies stay small.
MAX_BODY_BYTES=1048576

# [optional] Requests one client may make per window before getting a 429.
# Defaults to 300 per 60 seconds.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60

# [optional] Set to true only when the API runs behind a reverse proxy or load
# balancer you control. The client address then comes from X-Forwarded-For.
# Leave false otherwise, or clients could spoof their address to dodge rate limits.
TRUST_PROXY=false

# [optional] On SIGTERM/SIGINT the backend stops taking new requests and waits up
# to this many milliseconds for running ones to finish. Defaults to 10000.
SHUTDOWN_TIMEOUT_MS=10000

# [optional] Requests slower than this many milliseconds are logged as a warning
# with their method, path and duration. Defaults to 1000.
SLOW_REQUEST_MS=1000

# [required] Sender address for emails the backend sends (verification, invites, …).
# Must be a valid email on a domain you have verified in Resend.
# For quick local testing Resend allows onboarding@resend.dev.
# Shared secret for scheduled jobs (backend and worker). Generate with: openssl rand -base64 32
CRON_SECRET=
FROM_EMAIL=
# Encrypts saved onboarding drafts. Generate with: openssl rand -base64 32
ONBOARDING_DRAFT_KEY=
# Encrypts safeguarding concern details and notes, which are the most sensitive records.
# Use a different value from the drafts key. Generate with: openssl rand -base64 32
# Losing it makes those records unreadable, so keep a copy in your password manager.
SAFEGUARDING_KEY=

# [required] Resend API key used by the backend to send email.
# Create one at https://resend.com/api-keys. Secret: never commit.
RESEND_API_KEY=


# -----------------------------------------------------------------------------
# Notifications — Novu (packages/notifications)
# -----------------------------------------------------------------------------

# [required] Novu secret key for the in-app inbox and push notifications.
# Dashboard -> API keys (https://dashboard.novu.co). Secret: never commit.
NOVU_SECRET_KEY=

# [optional] Novu API URL. Leave blank for the US region.
# Use https://eu.api.novu.co for the EU region, or your own URL if self-hosted.
NOVU_API_URL=


# -----------------------------------------------------------------------------
# Authentication — Better Auth (packages/authentication)
# -----------------------------------------------------------------------------

# [required] Secret used to sign sessions, at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# [required] Public URL of the backend API, for example http://localhost:9000
BETTER_AUTH_URL=http://localhost:9000

# [optional] URL scheme of the native app, without "://". Must match "scheme" in
# apps/native/app.json. Defaults to huddlekit.
AUTH_NATIVE_SCHEME=huddlekit

# [required for the apps] Public URL of the backend API, as the browser or phone
# reaches it. NEXT_PUBLIC_ is read by the website and the platform, EXPO_PUBLIC_
# by the native app. On a physical phone use your computer's LAN address, not
# localhost. Neither is a secret.
NEXT_PUBLIC_API_URL=http://localhost:9000
EXPO_PUBLIC_API_URL=http://localhost:9000

# [optional] Domain passkeys are tied to. Defaults to localhost.
# In production use your registrable domain (e.g. huddlekit.app); it must be the
# web app's host or a parent of it. Changing it later invalidates every passkey.
PASSKEY_RP_ID=localhost

# [optional] Name shown in the browser's passkey prompt. Defaults to Huddlekit.
PASSKEY_RP_NAME=Huddlekit

# [optional] Public URL of the platform web app. Invitation emails link to
# <PLATFORM_URL>/accept-invite/<invitation id>. Defaults to http://localhost:8000.
PLATFORM_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# Billing — Stripe for Huddlekit itself (packages/payments)
# Clubs paying us a subscription. AUTH_STRIPE_* keys are ONLY for this. Money
# clubs collect from their own members (Stripe Connect) will use STRIPE_CONNECT_*.
# -----------------------------------------------------------------------------

# [required] Stripe secret key (sk_test_… locally, sk_live_… in production).
# Dashboard -> Developers -> API keys. Secret: never commit.
AUTH_STRIPE_SECRET_KEY=

# [required] Signing secret for the webhook endpoint (whsec_…).
# Endpoint URL: <BETTER_AUTH_URL>/api/auth/stripe/webhook
# Events: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted.
# Locally: stripe listen --forward-to localhost:9000/api/auth/stripe/webhook
# Secret: never commit.
AUTH_STRIPE_WEBHOOK_SECRET=

# [required] Price id (price_…) of the club subscription, from the Product catalog.
AUTH_STRIPE_CLUB_PRICE_ID=


# -----------------------------------------------------------------------------
# Connect — Stripe for clubs collecting money from their members
# (packages/payments, connect.ts). Optional: while either is empty the app starts
# and the /payments/connect routes answer 503. Never reuse AUTH_STRIPE_*.
# Webhook endpoint (on connected accounts): <backend>/api/v1/webhooks/stripe/connect
# Locally: stripe listen --forward-connect-to localhost:9000/api/v1/webhooks/stripe/connect
# -----------------------------------------------------------------------------

# [required for Connect] Restricted API key (rk_test_… locally) for the platform
# account. Give it only Connect, Checkout Sessions and Accounts v2 permissions.
# Secret: never commit.
STRIPE_CONNECT_SECRET_KEY=

# [required for Connect] Signing secret of the Connect webhook endpoint (whsec_…).
# Events (connected accounts): checkout.session.completed,
# checkout.session.async_payment_succeeded, charge.dispute.created,
# charge.refunded. Account events (thin): capability status changes on
# configuration.merchant. Secret: never commit.
STRIPE_CONNECT_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Worker — Trigger.dev (apps/worker)
# Background jobs and scheduled tasks. Docs: https://trigger.dev/docs
# Dashboard: https://cloud.trigger.dev  (project: proj_ueozrkuwhohpaqjtlysb)
# -----------------------------------------------------------------------------

# [required] Secret key for the Trigger.dev environment you're running in.
# Find it in the dashboard: your project -> API keys. Each environment has
# its own key, and the prefix tells you which one you're holding:
#   tr_dev_…   Development  (use this locally with `pnpm --filter @huddlekit/worker dev`)
#   tr_stg_…   Staging
#   tr_prod_…  Production   (set in your hosting provider's env, NOT in your local file)
# Treat it like a password: it lets whoever holds it trigger your tasks.
# Used by anything that *triggers* tasks (e.g. the backend); the worker's own
# `dev` command authenticates through `npx trigger.dev@latest login` instead.
TRIGGER_SECRET_KEY=

# [optional] Only set this if you self-host Trigger.dev.
# Leave blank to use Trigger.dev Cloud (https://api.trigger.dev).
# Example: https://trigger.example.com
TRIGGER_API_URL=


# -----------------------------------------------------------------------------
# Database — Postgres (packages/database)
# Drizzle ORM talks to Postgres through the `pg` driver. The same file feeds
# the app (createDatabase) and drizzle-kit (pnpm --filter @alice/database db:*).
# -----------------------------------------------------------------------------

# [required] Postgres connection string.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Use a database dedicated to this project: migrations create tables like
# users and organizations, which can clash with other apps sharing the server.
# With a hosted provider (Neon, Supabase, RDS, …) copy the connection string
# from its dashboard. Use a direct (non-pooled) connection for migrations if
# your provider offers both. Keep it secret: it grants full database access.
# Local example (Docker), then run `CREATE DATABASE huddlekit;`:
#   docker run -d --name huddlekit-postgres -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:17
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/huddlekit
DATABASE_URL=

# [optional] Set to true to log every SQL query (development debugging only).
# Accepts true/false (also 1/0, yes/no, on/off). Defaults to false.
DATABASE_LOGGER=false

# [optional] Most Postgres connections the backend keeps open. Defaults to 10.
# Keep it below your database's connection limit divided by the number of
# backend instances you run.
DATABASE_POOL_MAX=10

# [optional] Postgres cancels any query running longer than this many
# milliseconds, so one slow query can't hold a connection forever. Defaults to 15000.
DATABASE_STATEMENT_TIMEOUT_MS=15000

# [optional] Postgres used ONLY by `pnpm --filter @alice/database test:integration`.
# The tests run migrations and insert/delete rows, so point this at a throwaway
# database, never a real environment. It is deliberately separate from
# DATABASE_URL. Create the database once on your local Postgres:
#   CREATE DATABASE huddlekit_test;
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/huddlekit_test


# -----------------------------------------------------------------------------
# Storage — S3 file storage (packages/storage)
# Photos and reports are uploaded straight to S3 with presigned URLs, and each
# file gets a row in the `files` table. Locally, run Floci (https://floci.io), a
# local AWS emulator, in Docker on port 4566.
# -----------------------------------------------------------------------------

# [required] AWS region of the bucket, e.g. eu-west-2. Floci accepts any region.
AWS_REGION=us-east-1

# [required] Bucket that holds the files. Create it first (S3 console, or
# `aws --endpoint-url http://localhost:4566 s3 mb s3://huddlekit-dev` for Floci).
S3_BUCKET=huddlekit-dev

# [optional] Access keys. Leave BOTH blank in AWS to use the default credential
# chain (IAM role, SSO, ~/.aws). For Floci any non-empty values work, e.g. test/test.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# [optional] Custom S3 endpoint. Only for local emulators: Floci is http://localhost:4566.
# Leave blank for real AWS.
S3_ENDPOINT=

# [optional] Use path-style URLs (http://host/bucket/key). Required for Floci, leave
# false for real AWS. Defaults to false.
S3_FORCE_PATH_STYLE=false

# [optional] How long presigned upload/download links stay valid, in seconds.
# Defaults to 900 (15 minutes).
S3_PRESIGN_TTL_SECONDS=900

# [optional] Used ONLY by `pnpm --filter @alice/storage test:integration`. Points
# at your local Floci. The tests create and empty this bucket,
# so never use a real bucket. Separate from S3_BUCKET on purpose.
TEST_S3_ENDPOINT=http://localhost:4566
TEST_S3_BUCKET=huddlekit-test


# -----------------------------------------------------------------------------
# UI registry — shadcn (apps/platform, apps/website, packages/user-interface)
# Token for the private @shadcnuikit registry, referenced as ${REGISTRY_TOKEN}
# in each components.json. Only needed when running `shadcn add @shadcnuikit/…`.
# NOTE: the shadcn CLI reads .env from the folder you run it in, not this root
# file. Run it from the root, or export REGISTRY_TOKEN in your shell.
# -----------------------------------------------------------------------------

# [optional] Get it from your shadcnuikit.com account. Secret: never commit.
REGISTRY_TOKEN=
