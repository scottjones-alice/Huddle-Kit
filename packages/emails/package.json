{
  "name": "@alice/emails",
  "version": "0.0.0",
  "private": true,
  "description": "React Email templates, rendered to HTML and text for any email provider.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./templates/*": "./src/templates/*.tsx"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "email dev --dir src/templates --port 3003",
    "export": "email export --dir src/templates",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-email/components": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@alice/typescript": "workspace:*",
    "@react-email/ui": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react-email": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
