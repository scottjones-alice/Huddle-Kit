{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Expo",
  "extends": "./react-library.json",
  "compilerOptions": {
    "allowJs": true,
    "module": "Preserve",
    "customConditions": ["react-native"]
  },
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/babel.config.js",
    "${configDir}/metro.config.js",
    "${configDir}/jest.config.js",
    "${configDir}/android",
    "${configDir}/ios"
  ]
}
