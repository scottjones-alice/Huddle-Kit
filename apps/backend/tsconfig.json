{
  "extends": "@alice/typescript/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "../../packages/emails/src",
    "tests",
    "vitest.config.ts",
    "vitest.integration.config.ts"
  ]
}
