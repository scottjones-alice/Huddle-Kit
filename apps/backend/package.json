    "@alice/payments": "workspace:*",
    "@alice/storage": "workspace:*",
    "@asteasolutions/zod-to-openapi": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "@scalar/hono-api-reference": "catalog:",
    "@t3-oss/env-core": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "hono-pino": "catalog:",
    "openapi3-ts": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "resend": "catalog:",
