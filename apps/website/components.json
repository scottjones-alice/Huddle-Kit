{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "radix-nova",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "../../packages/user-interface/src/styles/globals.css",
    "baseColor": "neutral",
    "cssVariables": true
  },
  "iconLibrary": "lucide",
  "aliases": {
    "components": "@/components",
    "hooks": "@/hooks",
    "lib": "@/lib",
    "utils": "@alice/ui/lib/utils",
    "ui": "@alice/ui/components"
  },
  "registries": {
    "@shadcnuikit": {
      "url": "https://shadcnuikit.com/r/{name}.json",
      "headers": {
        "Authorization": "Bearer ${REGISTRY_TOKEN}"
      }
    }
  },
  "rtl": false,
  "menuColor": "default",
  "menuAccent": "subtle"
}
